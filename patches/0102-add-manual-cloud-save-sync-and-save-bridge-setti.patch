+NSString *dm_normalize_save_bridge_url(NSString *raw) {
+    NSString *trimmed = trim_string(raw);
+    if (!trimmed.length) return nil;
+    if ([trimmed hasPrefix:@"cloudkit://"]) {
+        while (trimmed.length > 11 && [trimmed hasSuffix:@"/"]) {
+            trimmed = [trimmed substringToIndex:trimmed.length - 1];
+        }
+        return [trimmed isEqualToString:@"cloudkit://"] ? nil : trimmed;
+    }
+    NSString *withScheme = [trimmed containsString:@"://"] ? trimmed : [@"http://" stringByAppendingString:trimmed];
+    NSURLComponents *comps = [NSURLComponents componentsWithString:withScheme];
+    NSString *scheme = comps.scheme.lowercaseString;
+    if (!comps || (![scheme isEqualToString:@"http"] && ![scheme isEqualToString:@"https"]) || !comps.host.length) {
+        return nil;
+    }
+    comps.scheme = scheme;
+    if (!comps.path.length || [comps.path isEqualToString:@"/"]) {
+        if ([scheme isEqualToString:@"http"] && !comps.port) comps.port = @47921;
+        comps.path = @"/saves";
+    } else {
+        NSString *p = comps.path;
+        while (p.length > 1 && [p hasSuffix:@"/"]) p = [p substringToIndex:p.length - 1];
+        comps.path = p;
+    }
+    return comps.string;
+}
