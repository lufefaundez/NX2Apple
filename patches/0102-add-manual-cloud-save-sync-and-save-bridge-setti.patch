+private struct SaveBridgeSection: View {
+    @State private var address: String = ""
+    @State private var token: String = ""
+    @State private var savedURL: String = ""
+    @State private var builtinTarget: String = ""
+    @State private var note: String = ""
+    @State private var discovering = false
+    @State private var syncing = false
+
+    private var statusText: String {
+        if !savedURL.isEmpty { return savedURL }
+        if !builtinTarget.isEmpty { return "Built-in" }
+        return "Off"
+    }
+
+    var body: some View {
+        Section {
+            HStack {
+                Text("Save server")
+                Spacer()
+                Text(statusText).foregroundStyle(.secondary).lineLimit(1).truncationMode(.middle)
+            }
+            TextField("192.168.1.10:47921", text: $address)
+                .textInputAutocapitalization(.never)
+                .autocorrectionDisabled()
+                .keyboardType(.URL)
+                .onSubmit { _ = applyBridge(showSavedNote: true) }
+            SecureField("Access key", text: $token)
+                .textInputAutocapitalization(.never)
+                .autocorrectionDisabled()
+                .onSubmit { _ = applyBridge(showSavedNote: true) }
+            Button(discovering ? "Searching…" : "Find Mac on Wi-Fi") { scanWiFi() }
+                .disabled(discovering || syncing)
+            Button(syncing ? "Syncing…" : "Sync now") { syncNow() }
+                .disabled(syncing)
+            if !savedURL.isEmpty || !(dm_save_bridge_token() ?? "").isEmpty {
+                Button("Clear save server", role: .destructive) { clearBridge() }
+                    .disabled(syncing)
+            }
+        } footer: {
+            Text(note.isEmpty
+                 ? "Connect to your Mac over Wi-Fi to sync saves when iCloud Drive is unavailable."
+                 : note)
+        }
+        .onAppear(perform: refresh)
+    }
+
+    private func refresh() {
+        savedURL = dm_save_bridge_url() ?? ""
+        builtinTarget = dm_builtin_save_target() ?? ""
+        if address.isEmpty { address = savedURL }
+        if token.isEmpty { token = dm_save_bridge_token() ?? "" }
+    }
+
+    @discardableResult
+    private func applyBridge(showSavedNote: Bool) -> Bool {
+        let trimmed = address.trimmingCharacters(in: .whitespacesAndNewlines)
+        if !trimmed.isEmpty {
+            guard let norm = dm_normalize_save_bridge_url(trimmed) else {
+                note = "Enter a valid server address, such as 192.168.1.10:47921."
+                return false
+            }
+            dm_set_save_bridge(norm, token)
+            address = norm
+            savedURL = dm_save_bridge_url() ?? norm
+            if showSavedNote { note = "Saved." }
+            return true
+        }
+        let trimmedTok = token.trimmingCharacters(in: .whitespacesAndNewlines)
+        if !savedURL.isEmpty || !trimmedTok.isEmpty {
+            dm_set_save_bridge(nil, trimmedTok.isEmpty ? nil : trimmedTok)
+            savedURL = dm_save_bridge_url() ?? ""
+            if showSavedNote { note = savedURL.isEmpty && trimmedTok.isEmpty ? "" : "Saved." }
+        }
+        return true
+    }
+
+    private func scanWiFi() {
+        discovering = true
+        note = ""
+        LauncherBridgeDiscovery.scan { found in
+            discovering = false
+            guard let found else {
+                note = "No Mac found on Wi-Fi"
+                return
+            }
+            address = found
+            dm_set_save_bridge(found, token)
+            savedURL = dm_save_bridge_url() ?? found
+            note = "Found Mac on Wi-Fi"
+        }
+    }
+
+    private func clearBridge() {
+        address = ""
+        token = ""
+        dm_set_save_bridge(nil, nil)
+        savedURL = ""
+        note = ""
+    }
+
+    private func syncNow() {
+        guard applyBridge(showSavedNote: false) else { return }
+        syncing = true
+        DispatchQueue.global(qos: .userInitiated).async {
+            var msg: NSString?
+            _ = dm_sync_cloud_saves_now(&msg)
+            let result = (msg as String?) ?? ""
+            DispatchQueue.main.async {
+                syncing = false
+                if !result.isEmpty { note = result }
+            }
+        }
+    }
+}
