+private final class LauncherBridgeDiscovery {
+    private let lock = NSLock()
+    private var finished = false
+    private var browser: NWBrowser?
+    private var connections: [NWConnection] = []
+    private var timeout: DispatchWorkItem?
+    private var completion: ((String?) -> Void)?
+
+    static func scan(timeoutSeconds: TimeInterval = 3.0, completion: @escaping (String?) -> Void) {
+        let holder = LauncherBridgeDiscovery()
+        holder.completion = completion
+        holder.start(timeoutSeconds: timeoutSeconds)
+    }
+
+    private func start(timeoutSeconds: TimeInterval) {
+        let queue = DispatchQueue(label: "org.nxnative.save-bridge-discovery", qos: .userInitiated)
+        let browser = NWBrowser(for: .bonjour(type: "_nx2apple-saves._tcp", domain: "local."), using: .tcp)
+        let timer = DispatchWorkItem { [self] in finish(with: nil) }
+        lock.lock()
+        self.browser = browser
+        self.timeout = timer
+        lock.unlock()
+        queue.asyncAfter(deadline: .now() + timeoutSeconds, execute: timer)
+
+        browser.browseResultsChangedHandler = { [self] results, _ in
+            for result in results { resolve(result.endpoint, queue: queue) }
+        }
+        browser.stateUpdateHandler = { [self] state in
+            if case .failed = state { finish(with: nil) }
+        }
+        browser.start(queue: queue)
+    }
+
+    private func resolve(_ endpoint: NWEndpoint, queue: DispatchQueue) {
+        let params = NWParameters.tcp
+        if let ip = params.defaultProtocolStack.internetProtocol as? NWProtocolIP.Options { ip.version = .v4 }
+        let conn = NWConnection(to: endpoint, using: params)
+        lock.lock()
+        guard !finished else { lock.unlock(); conn.cancel(); return }
+        connections.append(conn)
+        lock.unlock()
+        conn.stateUpdateHandler = { [self] state in
+            switch state {
+            case .ready:
+                if let url = extractURL(conn.currentPath?.remoteEndpoint) { finish(with: url) }
+                conn.cancel()
+            case .failed, .cancelled:
+                conn.cancel()
+            default: break
+            }
+        }
+        conn.start(queue: queue)
+    }
+
+    private func extractURL(_ endpoint: NWEndpoint?) -> String? {
+        guard case .hostPort(let host, let port) = endpoint, port.rawValue > 0 else { return nil }
+        switch host {
+        case .ipv4(let addr):
+            let b = addr.rawValue
+            guard b.count == 4 else { return nil }
+            return "http://\(b[0]).\(b[1]).\(b[2]).\(b[3]):\(port.rawValue)/saves"
+        case .name(let name, _) where !name.isEmpty:
+            return "http://\(name):\(port.rawValue)/saves"
+        default: return nil
+        }
+    }
+
+    private func finish(with url: String?) {
+        lock.lock()
+        guard !finished else { lock.unlock(); return }
+        finished = true
+        let done = completion; completion = nil
+        let b = browser; browser = nil
+        let conns = connections; connections.removeAll()
+        let timer = timeout; timeout = nil
+        lock.unlock()
+        timer?.cancel()
+        b?.cancel()
+        for c in conns { c.cancel() }
+        DispatchQueue.main.async { done?(url) }
+    }
+}
