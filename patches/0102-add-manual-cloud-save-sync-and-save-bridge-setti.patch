 int save_sync_after_exit(const char *save, const char *title);   // the Mac launcher once the host has exited (a crash included): 1 = in step, 0 = not
+// One-shot manual sync from an iOS/tvOS launcher before the game starts: returns -1 on error, 0 when off / empty / up to date, 1 when pulled, 2 when pushed.
+int save_sync_now(const char *save, const char *title, char *msg, size_t msg_cap);
 
