@@ -1,26 +1,43 @@
-// Cloud saves on the iPhone (dm/host/save_sync.h): the iCloud Drive folder the player picked in the
-// launcher's Cloud saves section (Launcher.swift), remembered across launches. The Mac app chooses the
-// same folder in its settings window. The host brings the save in from there when the game starts and
-// sends it there after each save.
-//
-// iOS does not let an app remember a path outside its sandbox. It lets it keep a bookmark: the document
-// picker grants access to the folder, and the bookmark resolves to it again after a relaunch. The
-// bookmark is bound to the app's signing identity, so a re-signed build cannot resolve it, and the
-// launcher asks the player to pick the folder again.
+// Cloud saves and LAN Save Bridge configuration for standalone iOS and tvOS apps
+// (dm/host/save_sync.h). Keeps the picked iCloud Drive folder bookmark on iOS as well as
+// user-entered or build-time LAN Save Bridge settings, and runs manual one-shot syncs.
 
 #import <Foundation/Foundation.h>
 
+NS_ASSUME_NONNULL_BEGIN
+
 /// The picked folder, or nil when there is none or it no longer resolves. `stale` (optional) is set
 /// when a bookmark exists but cannot be used under this signature.
-NSString *dm_cloud_saves_path(BOOL *stale);
+NSString * _Nullable dm_cloud_saves_path(BOOL * _Nullable stale);
 
 /// Store a bookmark for the folder the player just picked. Returns NO when the system refuses to make one.
 BOOL dm_store_cloud_saves(NSURL *url);
 
-/// Forget it: cloud saves off.
+/// Forget the picked cloud folder bookmark.
 void dm_clear_cloud_saves(void);
 
-/// Puts the picked folder into DM_SAVE_SYNC before the game starts (front_ios.m, at Play), its
-/// security scope held for the session. A DM_SAVE_SYNC from an env file or the launch environment
-/// wins. Turning cloud saves off in the launcher clears the one this set.
+/// Normalizes a LAN Save Bridge address (e.g. "192.168.1.10" -> "http://192.168.1.10:47921/saves"),
+/// preserving valid http(s):// and cloudkit:// targets, or returning nil when invalid.
+NSString * _Nullable dm_normalize_save_bridge_url(NSString * _Nullable raw);
+
+/// Runtime-saved LAN Save Bridge URL in NSUserDefaults, or nil if unset.
+NSString * _Nullable dm_save_bridge_url(void);
+
+/// Runtime-saved LAN Save Bridge Bearer token in NSUserDefaults, or nil if unset.
+NSString * _Nullable dm_save_bridge_token(void);
+
+/// Built-in target from Info.plist (DMCloudKitContainer / DMSaveBridgeURL), or nil if none.
+NSString * _Nullable dm_builtin_save_target(void);
+
+/// Stores or clears the runtime Save Bridge URL and Bearer token, then refreshes the environment.
+void dm_set_save_bridge(NSString * _Nullable url, NSString * _Nullable token);
+
+/// Updates DM_SAVE_SYNC / DM_SAVE_SYNC_TOKEN / DM_SAVE_SYNC_FALLBACK before the game starts or syncs.
+/// Values fixed by an env file or launch environment win.
 void dm_cloud_saves_env(void);
+
+/// Runs a blocking manual one-shot sync for the current standalone game profile (`save_sync_now`).
+/// Returns 0 (up to date / off / empty), 1 (pulled), 2 (pushed), or -1 (failed).
+int dm_sync_cloud_saves_now(NSString * _Nullable * _Nullable message);
+
+NS_ASSUME_NONNULL_END
