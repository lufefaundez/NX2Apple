+void dm_set_save_bridge(NSString *url, NSString *token) {
+    pthread_mutex_lock(&g_env_mu);
+    NSUserDefaults *defaults = NSUserDefaults.standardUserDefaults;
+    NSString *rawTrimmed = trim_string(url);
+    NSString *norm = dm_normalize_save_bridge_url(rawTrimmed);
+    if (norm.length) {
+        [defaults setObject:norm forKey:kSaveBridgeURL];
+    } else if (!rawTrimmed.length) {
+        [defaults removeObjectForKey:kSaveBridgeURL];
+    }
+    NSString *tok = trim_string(token);
+    if (tok.length) {
+        [defaults setObject:tok forKey:kSaveBridgeToken];
+    } else {
+        [defaults removeObjectForKey:kSaveBridgeToken];
+    }
+    cloud_saves_env_locked();
+    pthread_mutex_unlock(&g_env_mu);
+}
+
+void dm_cloud_saves_env(void) {
+    pthread_mutex_lock(&g_env_mu);
+    cloud_saves_env_locked();
+    pthread_mutex_unlock(&g_env_mu);
 }
