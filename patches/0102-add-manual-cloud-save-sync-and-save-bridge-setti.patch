+static NSString *standalone_app_data_dir(void) {
+#if TARGET_OS_TV
+    return NSSearchPathForDirectoriesInDomains(NSCachesDirectory, NSUserDomainMask, YES)[0];
+#else
+    return NSSearchPathForDirectoriesInDomains(NSDocumentDirectory, NSUserDomainMask, YES)[0];
 #endif
+}
+
+static NSString *standalone_save_dir(const char *titleID) {
+    const char *envSave = getenv("DM_SAVE");
+    if (envSave && *envSave) return @(envSave);
+    NSString *doc = standalone_app_data_dir();
+    NSString *gdir = [[doc stringByAppendingPathComponent:@"games"] stringByAppendingPathComponent:@(titleID)];
+    NSFileManager *fm = NSFileManager.defaultManager;
+    for (NSString *sub in @[@"save", @"romfs.img", @"romfs"]) {
+        if ([fm fileExistsAtPath:[gdir stringByAppendingPathComponent:sub]]) {
+            return [gdir stringByAppendingPathComponent:@"save"];
+        }
+    }
+    return [doc stringByAppendingPathComponent:@"save"];
+}
+
+int dm_sync_cloud_saves_now(NSString * _Nullable * _Nullable message) {
+    pthread_mutex_lock(&g_sync_mu);
+    pthread_mutex_lock(&g_env_mu);
+    cloud_saves_env_locked();
+    const struct dm_profile *prof = dm_profile();
+    const char *tid = (prof && prof->id[0]) ? prof->id : "";
+    NSString *saveDir = *tid ? standalone_save_dir(tid) : nil;
+    pthread_mutex_unlock(&g_env_mu);
+
+    if (!*tid || !saveDir.length) {
+        if (message) *message = @"No game profile available";
+        pthread_mutex_unlock(&g_sync_mu);
+        return -1;
+    }
+
+    char buf[256] = "";
+    int rc = save_sync_now(saveDir.fileSystemRepresentation, tid, buf, sizeof buf);
+    if (message) *message = buf[0] ? @(buf) : @"";
+    pthread_mutex_unlock(&g_sync_mu);
+    return rc;
+}
