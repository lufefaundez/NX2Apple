diff --git a/dm/host/save_sync.c b/dm/host/save_sync.c
index 0802b07..93644de 100644
--- a/dm/host/save_sync.c
+++ b/dm/host/save_sync.c
@@ -62,6 +62,12 @@ static int mkdirs(const char *path) {   // mkdir -p
     return mkdir(p, 0755) && errno != EEXIST ? -1 : 0;
 }
 
+static int mkdirs_parent(const char *path) {
+    char d[PATH_MAX]; if (snprintf(d, sizeof d, "%s", path) >= (int)sizeof d) return -1;
+    char *s = strrchr(d, '/');
+    return s && s > d ? (*s = 0, mkdirs(d)) : 0;
+}
+
 static int rm_tree(const char *p) {   // rm -rf: 0 when nothing is left
     struct stat st; if (lstat(p, &st)) return errno == ENOENT ? 0 : -1;
     if (!S_ISDIR(st.st_mode)) return unlink(p);
@@ -400,19 +406,22 @@ static int pull(const char *save, const char *bundle, ss_meta *r, char *kept, si
     char tmp[PATH_MAX]; snprintf(tmp, sizeof tmp, "%s.sync-tmp/in", save);
     kept[0] = 0;
     if (rm_tree(tmp) || mkdirs(tmp) || ss_read(bundle, tmp, r)) { rm_tree(tmp); return -1; }
+    int ok = -1;
     for (int i = 0; i < 2; i++) {
         char here[PATH_MAX], incoming[PATH_MAX], old[PATH_MAX];
         folder_path(save, i, here, sizeof here); snprintf(incoming, sizeof incoming, "%s/%s", tmp, FOLDERS[i]);
         int fresh = !access(incoming, F_OK), had = has_entries(here);
-        if (had && !*kept && backup_dir(save, "local", kept, kn)) return -1;
+        if (had && !*kept && backup_dir(save, "local", kept, kn)) goto out;
         snprintf(old, sizeof old, "%s/%s", kept, FOLDERS[i]);
         if (fresh && !access(here, F_OK)) {   // swapped: here holds the cloud's, incoming this device's
-            if (renamex_np(incoming, here, RENAME_SWAP) || (had ? rename(incoming, old) : rm_tree(incoming))) return -1;
-        } else if (fresh) { if (rename(incoming, here)) return -1; }
-        else if (had && rename(here, old)) return -1;   // a folder the cloud's save does not have: this device's goes, so both hold the same
+            if (renamex_np(incoming, here, RENAME_SWAP) || (had ? rename(incoming, old) : rm_tree(incoming))) goto out;
+        } else if (fresh) { if (mkdirs_parent(here) || rename(incoming, here)) goto out; }
+        else if (had && rename(here, old)) goto out;   // a folder the cloud's save does not have: this device's goes, so both hold the same
     }
+    ok = 0;
+out:
     rm_tree(tmp);
-    return 0;
+    return ok;
 }
 
 // What this device committed goes to the cloud, unless the cloud already has it. A cloud save changed since this device's last sync (another device sent it) is kept first.
@@ -493,7 +502,7 @@ static void mount_once(const char *save, const char *title) {
     read_base(save, base);
     int got = fetch_timed(cloud, theirs, FETCH_MS), both = 0, failed = 0;
     if (got > 0 && ss_read(theirs, NULL, &other)) { SRED("the cloud's save %s is damaged: playing on with this device's, which replaces it", cloud); got = 0; }
-    else if (got > 0 && strcasecmp(other.title, title)) { SRED("the cloud's save %s is %s's, not %s's: not used", cloud, other.title, title); got = -1; }
+    else if (got > 0 && *other.title && strcasecmp(other.title, title)) { SRED("the cloud's save %s is %s's, not %s's: not used", cloud, other.title, title); got = -1; }
     if (got < 0) { SLOG("playing on with this device's save; it is sent after the game saves, unless the cloud's has changed meanwhile (then that one is kept)"); failed = 1; }
     switch (got < 0 ? SS_KEEP : ss_decide(mine.hash, base, got ? other.hash : "", mine.saved, other.saved, &both)) {
     case SS_PULL:
@@ -550,6 +559,105 @@ int save_sync_after_exit(const char *save, const char *title) {   // save: DM_SA
     return !cloud_file(title, cloud, sizeof cloud) || send_save(dd, title, cloud);
 }
 
+static void set_sync_msg(char *msg, size_t cap, const char *s) {
+    if (msg && cap) snprintf(msg, cap, "%s", s ? s : "");
+}
+
+int save_sync_now(const char *save, const char *title, char *msg, size_t msg_cap) {
+    char cloud[PATH_MAX], dd[PATH_MAX], tmp[PATH_MAX], theirs[PATH_MAX], packed[PATH_MAX], base[SS_HASH + 1], kept[PATH_MAX], t[32];
+    ss_meta mine, other; memset(&other, 0, sizeof other);
+    packed[0] = 0;
+    if (!save || !*save || !title || !*title) { set_sync_msg(msg, msg_cap, "No save location configured"); return -1; }
+    snprintf(dd, sizeof dd, "%s", save); size_t L = strlen(dd); while (L > 1 && dd[L - 1] == '/') dd[--L] = 0;
+    if (!cloud_file(title, cloud, sizeof cloud)) { set_sync_msg(msg, msg_cap, "Cloud save sync is off"); return 0; }
+    if (ss_scan(dd, &mine)) { SRED("manual sync: this device's save %s cannot be read (errno=%d)", dd, errno); set_sync_msg(msg, msg_cap, "Cannot read local save"); return -1; }
+    read_base(dd, base);
+    snprintf(tmp, sizeof tmp, "%s.sync-tmp", dd); snprintf(theirs, sizeof theirs, "%s/in.dmsync", tmp);
+    if (rm_tree(tmp) || mkdirs(tmp)) { SRED("manual sync: cannot make %s (errno=%d)", tmp, errno); set_sync_msg(msg, msg_cap, "Cannot create temporary sync folder"); return -1; }
+    int got = fetch_timed(cloud, theirs, FETCH_MS), both = 0, rc = -1;
+    if (got < 0) {
+        SLOG("manual sync: could not reach %s", cloud);
+        set_sync_msg(msg, msg_cap, "Could not reach cloud save or save server");
+        goto done;
+    }
+    if (got > 0 && ss_read(theirs, NULL, &other)) {
+        SRED("manual sync: the cloud's save %s is unreadable", cloud);
+        set_sync_msg(msg, msg_cap, "Cloud save file is unreadable");
+        goto done;
+    }
+    if (got > 0 && *other.title && strcasecmp(other.title, title)) {
+        SRED("manual sync: the cloud's save %s is %s's, not %s's", cloud, other.title, title);
+        set_sync_msg(msg, msg_cap, "Cloud save belongs to a different game");
+        goto done;
+    }
+    switch (ss_decide(mine.hash, base, got ? other.hash : "", mine.saved, other.saved, &both)) {
+    case SS_KEEP:
+        if (got > 0 && mine.files) {
+            write_base(dd, mine.hash);
+            SLOG("manual sync: in step with %s", cloud);
+            set_sync_msg(msg, msg_cap, "Saves up to date");
+        } else {
+            SLOG("manual sync: no save here or in %s yet", cloud);
+            set_sync_msg(msg, msg_cap, "No save here or in the cloud yet");
+        }
+        rc = 0;
+        break;
+    case SS_PULL:
+        when(other.saved, t, sizeof t);
+        if (pull(dd, theirs, &other, kept, sizeof kept)) {
+            SRED("manual sync: bringing the cloud's save in failed (errno=%d)", errno);
+            set_sync_msg(msg, msg_cap, "Failed to restore cloud save");
+            goto done;
+        }
+        write_base(dd, other.hash);
+        SLOG("manual sync: brought in the cloud's save (from %s, saved %s%s)%s%s",
+             other.device, t, both ? ", the newer of two that both changed" : "", *kept ? "; this device's is kept in " : "", kept);
+        set_sync_msg(msg, msg_cap, "Save downloaded");
+        rc = 1;
+        break;
+    case SS_PUSH:
+        if (got > 0 && other.files && strcmp(other.hash, base)) {
+            if (backup_dir(dd, "cloud", kept, sizeof kept) || ss_read(theirs, kept, &other)) {
+                SRED("manual sync: cannot keep the cloud's save before replacing it (errno=%d)", errno);
+                set_sync_msg(msg, msg_cap, "Failed to back up cloud save");
+                goto done;
+            }
+            when(other.saved, t, sizeof t);
+            SLOG("manual sync: kept cloud save (from %s, saved %s) in %s", other.device, t, kept);
+        }
+        snprintf(packed, sizeof packed, "%s/out.dmsync", tmp);
+        if (ss_pack(dd, title, packed, &mine)) {
+            SRED("manual sync: packing %s failed (errno=%d)", dd, errno);
+            set_sync_msg(msg, msg_cap, "Failed to pack local save");
+            goto done;
+        }
+        if (!is_remote_url(cloud)) {
+            char dir[PATH_MAX]; snprintf(dir, sizeof dir, "%s", cloud); *strrchr(dir, '/') = 0;
+            if (mkdirs(dir)) {
+                SRED("manual sync: sending to %s failed (errno=%d)", cloud, errno);
+                set_sync_msg(msg, msg_cap, "Failed to upload save");
+                goto done;
+            }
+        }
+        if (front_save_sync_store(packed, cloud) != 1) {
+            SRED("manual sync: sending to %s failed (errno=%d)", cloud, errno);
+            set_sync_msg(msg, msg_cap, "Failed to upload save");
+            goto done;
+        }
+        write_base(dd, mine.hash);
+        when(mine.saved, t, sizeof t);
+        SLOG("manual sync: sent %d files, saved %s, to %s", mine.files, t, cloud);
+        set_sync_msg(msg, msg_cap, "Save uploaded");
+        rc = 2;
+        break;
+    }
+done:
+    if (packed[0]) unlink(packed);
+    if (got >= 0) rm_tree(tmp);
+    else rmdir(tmp);
+    return rc;
+}
+
 // ---------- the platform's parts: these defaults are plain file copies, which the Mac's iCloud Drive takes (it downloads a file a read asks for) ----------
 __attribute__((weak)) int dm_save_sync_remote_is_url(const char *cloud) { return is_remote_url(cloud); }
 __attribute__((weak)) int dm_save_sync_remote_fetch(const char *cloud, const char *local) { (void)cloud; (void)local; return -1; }
