+DEFAULT_SHELL_NAME=NX2Apple; [ "$DM_PLATFORM" = tvos ] && DEFAULT_SHELL_NAME="NX2Apple TV"
+export LC_ALL=C DM_BUNDLE_ID=${DM_BUNDLE_ID:-org.nxnative.shell} DM_TEAM_ID=${DM_TEAM_ID:-0000000000} DM_SHELL_NAME=${DM_SHELL_NAME:-$DEFAULT_SHELL_NAME} DM_APP_VERSION=${DM_APP_VERSION:-1.0}
 export DM_FORK_PATCHES=$(paste -sd, "$DM/fork_patches.txt" 2>/dev/null || true)
 DD=${DM_XCODE_DERIVED_DATA:-$S/dd}; mkdir -p "$DD" && DD=$(cd "$DD" && pwd)
