+// Adapt dual-motor HD Rumble for iPhone Taptic Engine (perceptual LRA gamma, dual-band sharpness, debounced transient edges).
+void dm_haptics_apple_phone_synthesize(const dm_vibration motors[2], float gain, float prev_intensity,
+    double now_sec, double *last_transient_sec, dm_haptic_level *out_level,
+    int *out_fire_transient, float *out_transient_intensity, float *out_transient_sharpness);
 // Native HID alternative. Runs on the adapter's serial queue, refreshed at 40 ms
 // while nonzero; receives zero on route changes/suspend/exit. Owner identifies
 // an unchanged route. Never calls hardware on a guest thread.
diff --git a/dm/host/haptics_apple.m b/dm/host/haptics_apple.m
index 2dc5083..7aec3b3 100644
--- a/dm/host/haptics_apple.m
+++ b/dm/host/haptics_apple.m
@@ -32,6 +32,10 @@
 @property(nonatomic) id<CHHapticPatternPlayer> previous;   // the pulse before the scheduled one, still playing
 @property(nonatomic) NSTimeInterval pulseEnd;   // engine time at which the last scheduled pulse ends
 @property(nonatomic) dm_haptic_level level;   // the level the next pulse starts at
+@property(nonatomic) float lastPhoneIntensity;
+@property(nonatomic) NSTimeInterval lastTransientAt;
+- (BOOL)applyLevel:(dm_haptic_level)level;
