+@implementation DmStatsHud
+- (instancetype)initWithContentView:(NSView *)cv {
+    if ((self = [super init])) {
+        _lastFPS = NAN;
+        _view = [[DmStatsHudView alloc] initWithFrame:NSMakeRect(12, MAX(12, cv.bounds.size.height - 36), 160, 24)];
+        _view.wantsLayer = YES;
+        _view.layer.backgroundColor = [NSColor colorWithWhite:0 alpha:0.62].CGColor;
+        _view.layer.cornerRadius = 7.0;
+        _view.layer.masksToBounds = YES;
+        _view.autoresizingMask = NSViewMaxXMargin | NSViewMinYMargin;
+        _view.hidden = YES;
+
+        _label = [NSTextField labelWithString:@""];
+        _label.font = [NSFont monospacedDigitSystemFontOfSize:12 weight:NSFontWeightSemibold];
+        _label.textColor = NSColor.whiteColor;
+        _label.maximumNumberOfLines = 1;
+        _label.lineBreakMode = NSLineBreakByClipping;
+        [_view addSubview:_label];
+        [cv addSubview:_view];
+    }
+    return self;
+}
+- (void)layout {
+    NSView *cv = _view.superview;
+    if (!cv) return;
+    [_label sizeToFit];
+    CGFloat lw = ceil(_label.frame.size.width), lh = ceil(_label.frame.size.height);
+    CGFloat w = lw + 18.0, h = lh + 8.0;
+    _label.frame = NSMakeRect(9.0, 4.0, lw, lh);
+    CGFloat maxW = MAX(80.0, cv.bounds.size.width - 24.0);
+    if (w > maxW) w = maxW;
+    CGFloat y = MAX(12.0, cv.bounds.size.height - h - 12.0);
+    _view.frame = NSMakeRect(12.0, y, w, h);
+}
+- (void)refreshText {
+    char buf[256];
+    dm_stats_snapshot snap = dm_stats_read();
+    dm_stats_format_hud(_lastFPS, &snap, 0, buf, sizeof buf);
+    NSString *text = @(buf);
+    if (![_label.stringValue isEqualToString:text]) {
+        _label.stringValue = text;
+        [self layout];
+    }
+}
+- (void)setVisible:(BOOL)on persist:(BOOL)persist logChange:(BOOL)logChange {
+    _on = on;
+    _view.hidden = !on;
+    _menuItem.state = on ? NSControlStateValueOn : NSControlStateValueOff;
+    if (persist) [NSUserDefaults.standardUserDefaults setBool:on forKey:@"DmShowStatsHUD"];
+    if (logChange) LOG("front end: stats HUD %s", on ? "on" : "off");
+    if (on) {
+        _lastFPS = NAN;
+        _fpsCount0 = mtl_present_count();
+        _fpsTime0 = CACurrentMediaTime();
+        [self refreshText];
+        [self layout];
+        if (!_timer.isValid) {
+            __weak DmStatsHud *weak = self;
+            _timer = [NSTimer scheduledTimerWithTimeInterval:1.0 repeats:YES block:^(NSTimer *t) {
+                (void)t;
+                DmStatsHud *s = weak;
+                if (!s || !s.on) return;
+                uint64_t n = mtl_present_count();
+                double now = CACurrentMediaTime(), dt = now - s.fpsTime0;
+                if (dt > 0.25 && dt < 2.5) s.lastFPS = (double)(n - s.fpsCount0) / dt;
+                else s.lastFPS = NAN;
+                s.fpsCount0 = n;
+                s.fpsTime0 = now;
+                [s refreshText];
+            }];
+        }
+    } else {
+        [_timer invalidate];
+        _timer = nil;
+    }
+}
+- (void)toggle:(id)sender {
+    (void)sender;
+    [self setVisible:!_on persist:YES logChange:YES];
+}
+@end
