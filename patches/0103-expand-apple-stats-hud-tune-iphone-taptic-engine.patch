diff --git a/dm/host/tests/t_stats_apple.m b/dm/host/tests/t_stats_apple.m
new file mode 100644
index 0000000..961bda0
--- /dev/null
+++ b/dm/host/tests/t_stats_apple.m
@@ -0,0 +1,143 @@
+// Unit tests for Apple telemetry helpers and macOS sensor snapshot reading (stats_apple.h).
+#import "../stats_apple.h"
+#import <Foundation/Foundation.h>
+#include <assert.h>
+#include <math.h>
+#include <stdio.h>
+#include <string.h>
+
+static void test_temp_valid(void) {
+    assert(dm_stats_temp_valid(45.5) == 45.5);
+    assert(dm_stats_temp_valid(0.1) == 0.1);
+    assert(dm_stats_temp_valid(129.9) == 129.9);
+    assert(isnan(dm_stats_temp_valid(0.0)));
+    assert(isnan(dm_stats_temp_valid(-5.0)));
+    assert(isnan(dm_stats_temp_valid(130.0)));
+    assert(isnan(dm_stats_temp_valid(250.0)));
+    assert(isnan(dm_stats_temp_valid(NAN)));
+    assert(isnan(dm_stats_temp_valid(INFINITY)));
+}
+
+static void test_b62_prev(void) {
+    char p = 0;
+    assert(dm_stats_smc_b62_prev('0', &p) == 0);
+    assert(dm_stats_smc_b62_prev('1', &p) == 1 && p == '0');
+    assert(dm_stats_smc_b62_prev('9', &p) == 1 && p == '8');
+    assert(dm_stats_smc_b62_prev('A', &p) == 1 && p == '9');
+    assert(dm_stats_smc_b62_prev('B', &p) == 1 && p == 'A');
+    assert(dm_stats_smc_b62_prev('Z', &p) == 1 && p == 'Y');
+    assert(dm_stats_smc_b62_prev('a', &p) == 1 && p == 'Z');
+    assert(dm_stats_smc_b62_prev('b', &p) == 1 && p == 'a');
+    assert(dm_stats_smc_b62_prev('z', &p) == 1 && p == 'y');
+    assert(dm_stats_smc_b62_prev('?', &p) == 0);
+    assert(dm_stats_smc_b62_prev('1', NULL) == 0);
+}
+
+static void test_smc_primary_reading(void) {
+    // M4-style contiguous clusters (Tp0U/V/W then immediately Tp0X/Y/Z, Te0R/S/T then Te0U, GPU Tg0C/D, plus M1 stride-4 Tp01/05/09)
+    const char *keys[] = {
+        "Tp00", "Tp01", "Tp02",
+        "Tp0U", "Tp0V", "Tp0W",
+        "Tp0X", "Tp0Y", "Tp0Z",
+        "Te0R", "Te0S", "Te0T",
+        "Te0U",
+        "Tg0C", "Tg0D",
+        "Tp05", "Tp09",
+        "TC0P", "TG0B"
+    };
+    const double vals[] = {
+        50.6, 57.7, 69.1,
+        51.0, 58.2, 75.9,
+        52.3, 59.0, 70.4,
+        49.5, 53.0, 56.2,
+        51.1,
+        43.6, 48.2,
+        52.0, 51.5,
+        48.0, NAN
+    };
+    const size_t n = sizeof keys / sizeof keys[0];
+
+    // Primary readings: cluster heads, M1 stride-4 without immediate prev, Intel CPU, plus Tp0X/Te0U despite adjacent prev Tp0W/Te0T
+    assert(dm_stats_smc_is_primary_reading(keys, vals, n, 0) == 1);  // Tp00
+    assert(dm_stats_smc_is_primary_reading(keys, vals, n, 1) == 0);  // Tp01 (> Tp00 + 2.5)
+    assert(dm_stats_smc_is_primary_reading(keys, vals, n, 2) == 0);  // Tp02 (> Tp01 + 2.5)
+    assert(dm_stats_smc_is_primary_reading(keys, vals, n, 3) == 1);  // Tp0U (no Tp0T present)
+    assert(dm_stats_smc_is_primary_reading(keys, vals, n, 4) == 0);  // Tp0V
+    assert(dm_stats_smc_is_primary_reading(keys, vals, n, 5) == 0);  // Tp0W
+    assert(dm_stats_smc_is_primary_reading(keys, vals, n, 6) == 1);  // Tp0X (52.3 <= 75.9 + 2.5 -> next physical core)
+    assert(dm_stats_smc_is_primary_reading(keys, vals, n, 7) == 0);  // Tp0Y
+    assert(dm_stats_smc_is_primary_reading(keys, vals, n, 8) == 0);  // Tp0Z
+    assert(dm_stats_smc_is_primary_reading(keys, vals, n, 9) == 1);  // Te0R
+    assert(dm_stats_smc_is_primary_reading(keys, vals, n, 10) == 0); // Te0S
+    assert(dm_stats_smc_is_primary_reading(keys, vals, n, 11) == 0); // Te0T
+    assert(dm_stats_smc_is_primary_reading(keys, vals, n, 12) == 1); // Te0U (51.1 <= 56.2 + 2.5 -> next physical core)
+    assert(dm_stats_smc_is_primary_reading(keys, vals, n, 13) == 1); // Tg0C
+    assert(dm_stats_smc_is_primary_reading(keys, vals, n, 14) == 0); // Tg0D
+    assert(dm_stats_smc_is_primary_reading(keys, vals, n, 15) == 1); // Tp05 (no Tp04 present)
+    assert(dm_stats_smc_is_primary_reading(keys, vals, n, 16) == 1); // Tp09 (no Tp08 present)
+    assert(dm_stats_smc_is_primary_reading(keys, vals, n, 17) == 1); // TC0P
+    assert(dm_stats_smc_is_primary_reading(keys, vals, n, 18) == 0); // TG0B (NAN)
+}
+
+static void test_format_hud(void) {
+    char buf[256];
+
+    dm_stats_snapshot full = {
+        .cpu_temp_c = 61.6, .gpu_temp_c = 54.4,
+        .device_battery_pct = 82, .device_charging = 1,
+        .pad_battery_pct = 90, .pad_charging = 0,
+        .thermal_state = 1,
+    };
+    dm_stats_format_hud(60.0, &full, 0, buf, sizeof buf);
+    assert(strcmp(buf, "60 fps · CPU 62°C · GPU 54°C · Bat 82%+ · Mando 90%") == 0);
+
+    dm_stats_format_hud(59.6, &full, 1, buf, sizeof buf);
+    assert(strcmp(buf, "60 fps · CPU 62°C · GPU 54°C\nBat 82%+ · Mando 90%") == 0);
+
+    // iOS/tvOS sandbox: unavailable sensors must stay "--°C" and absent batteries must be omitted
+    dm_stats_snapshot ios_blocked = {
+        .cpu_temp_c = NAN, .gpu_temp_c = NAN,
+        .device_battery_pct = 75, .device_charging = 0,
+        .pad_battery_pct = -1, .pad_charging = -1,
+        .thermal_state = 2,
+    };
+    dm_stats_format_hud(30.0, &ios_blocked, 1, buf, sizeof buf);
+    assert(strcmp(buf, "30 fps · CPU --°C · GPU --°C\nBat 75% · Calor") == 0);
+
+    // Critical thermal + no battery (tvOS / desktop Mac), unknown FPS
+    dm_stats_snapshot tv_hot = {
+        .cpu_temp_c = NAN, .gpu_temp_c = NAN,
+        .device_battery_pct = -1, .device_charging = -1,
+        .pad_battery_pct = 40, .pad_charging = 1,
+        .thermal_state = 3,
+    };
+    dm_stats_format_hud(NAN, &tv_hot, 0, buf, sizeof buf);
+    assert(strcmp(buf, "-- fps · CPU --°C · GPU --°C · Mando 40%+ · Crítico") == 0);
+
+    // Compact with neither battery nor elevated thermal drops the second line cleanly
+    dm_stats_snapshot minimal = {NAN, NAN, -1, -1, -1, -1, 0};
+    dm_stats_format_hud(60.0, &minimal, 1, buf, sizeof buf);
+    assert(strcmp(buf, "60 fps · CPU --°C · GPU --°C") == 0);
+}
+
+static void test_live_mac_snapshot(void) {
+    dm_stats_init();
+    dm_stats_snapshot s = dm_stats_read();
+    // On Apple Silicon Macs running this suite, SMC or IOHID reports valid temps in (0, 130) C
+    if (isfinite(s.cpu_temp_c)) assert(s.cpu_temp_c > 5.0 && s.cpu_temp_c < 120.0);
+    if (isfinite(s.gpu_temp_c)) assert(s.gpu_temp_c > 5.0 && s.gpu_temp_c < 120.0);
+    assert(s.device_battery_pct == -1 || (s.device_battery_pct >= 0 && s.device_battery_pct <= 100));
+    assert(s.pad_battery_pct == -1 || (s.pad_battery_pct >= 0 && s.pad_battery_pct <= 100));
+    assert(s.thermal_state >= 0 && s.thermal_state <= 3);
+    printf("t_stats_apple OK (cpu=%.1f gpu=%.1f bat=%d pad=%d thermal=%d)\n",
+           s.cpu_temp_c, s.gpu_temp_c, s.device_battery_pct, s.pad_battery_pct, s.thermal_state);
+}
+
+int main(void) { @autoreleasepool {
+    test_temp_valid();
+    test_b62_prev();
+    test_smc_primary_reading();
+    test_format_hud();
+    test_live_mac_snapshot();
+    return 0;
+} }
