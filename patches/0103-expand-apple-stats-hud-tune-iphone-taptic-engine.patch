@@ -78,6 +82,45 @@ float dm_haptics_apple_controller_intensity(float x) {
     x = isfinite(x) ? fmaxf(0, fminf(1, x)) : 0;
     return x <= rumble_min ? 0 : (x - rumble_min) / (1 - rumble_min);
 }
+static float clamp_unit(float x) { return isfinite(x) ? fmaxf(0.0f, fminf(1.0f, x)) : 0.0f; }
+void dm_haptics_apple_phone_synthesize(const dm_vibration motors[2], float g, float prev_intensity,
+    double now_sec, double *last_transient_sec, dm_haptic_level *out_level,
+    int *out_fire_transient, float *out_transient_intensity, float *out_transient_sharpness) {
+    if (out_level) *out_level = (dm_haptic_level){0.0f, 0.0f};
+    if (out_fire_transient) *out_fire_transient = 0;
+    if (out_transient_intensity) *out_transient_intensity = 0.0f;
+    if (out_transient_sharpness) *out_transient_sharpness = 0.0f;
+    if (!motors || !isfinite(g) || g <= 0.0f) return;
+
+    float p_sum = 0.0f, s_weighted = 0.0f;
+    for (int i = 0; i < 2; i++) {
+        float lo = clamp_unit(motors[i].amplitude_low), hi = clamp_unit(motors[i].amplitude_high);
+        float e_lo = lo * lo, e_hi = hi * hi;
+        float flo = isfinite(motors[i].frequency_low) && motors[i].frequency_low > 0.0f ? fmaxf(40.0f, fminf(250.0f, motors[i].frequency_low)) : 160.0f;
+        float fhi = isfinite(motors[i].frequency_high) && motors[i].frequency_high > 0.0f ? fmaxf(160.0f, fminf(1250.0f, motors[i].frequency_high)) : 320.0f;
+        float t_lo = logf(flo / 40.0f) / logf(250.0f / 40.0f);
+        float t_hi = logf(fhi / 160.0f) / logf(1250.0f / 160.0f);
+        float s_lo = 0.08f + 0.37f * t_lo;
+        float s_hi = 0.48f + 0.52f * t_hi;
+        p_sum += e_lo + e_hi;
+        s_weighted += e_lo * s_lo + e_hi * s_hi;
+    }
+    float rms = sqrtf(p_sum * 0.5f);
+    float raw = fminf(1.0f, rms * g);
+    float intensity = raw < 0.015f ? 0.0f : powf(raw, 0.72f);
+    float sharpness = (intensity > 0.0f && p_sum > 0.0f) ? fmaxf(0.0f, fminf(1.0f, s_weighted / p_sum)) : 0.0f;
+    if (out_level) *out_level = (dm_haptic_level){intensity, sharpness};
+
+    float prev = isfinite(prev_intensity) ? fmaxf(0.0f, prev_intensity) : 0.0f;
+    double last_t = last_transient_sec ? *last_transient_sec : 0.0;
+    int cooled = !isfinite(last_t) || last_t <= 0.0 || !isfinite(now_sec) || (now_sec - last_t) >= 0.035;
+    if (intensity >= 0.15f && (intensity - prev) >= 0.18f && cooled) {
+        if (out_fire_transient) *out_fire_transient = 1;
+        if (last_transient_sec && isfinite(now_sec)) *last_transient_sec = now_sec;
+        if (out_transient_intensity) *out_transient_intensity = fminf(1.0f, intensity * 1.15f);
+        if (out_transient_sharpness) *out_transient_sharpness = fmaxf(0.45f, sharpness);
+    }
+}
