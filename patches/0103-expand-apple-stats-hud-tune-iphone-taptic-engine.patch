+- (void)hudSlotWithSafeInsets:(UIEdgeInsets)insets layout:(DmLayout)layout compact:(BOOL *)compactOut slot:(CGRect *)slotOut midY:(CGFloat *)midYOut {
+    CGRect bounds = self.bounds;
+    UIEdgeInsets gameInsets = dm_game_safe_insets(bounds, insets, layout.topSafeOnly);
+    CGRect topSafe = UIEdgeInsetsInsetRect(bounds, gameInsets);
+    BOOL padOff = _padOff;
+#if TARGET_OS_TV
+    padOff = YES;
+#endif
+    if (TARGET_OS_TV || (layout.separated && !layout.onTV)) {
+        if (compactOut) *compactOut = NO;
+        if (midYOut) *midYOut = -1;
+        if (slotOut) *slotOut = CGRectMake(CGRectGetMinX(topSafe) + 10, CGRectGetMinY(topSafe) + 8, MAX(0, CGRectGetWidth(topSafe) - 20), MAX(0, CGRectGetHeight(topSafe) - 16));
+        return;
+    }
+    DmPadGeo g = dm_pad_geo(bounds, insets, layout, _full, _opts);
+    if (padOff || _tap) {
+        CGFloat minX = CGRectGetMinX(g.safe) + 10;
+        BOOL menuVisible = !(padOff && layout.onTV);
+        CGFloat maxX = menuVisible ? g.swap.x - g.swapR - 10 : CGRectGetMaxX(g.safe) - 10;
+        if (compactOut) *compactOut = NO;
+        if (midYOut) *midYOut = menuVisible ? g.swap.y : -1;
+        if (slotOut) *slotOut = CGRectMake(minX, CGRectGetMinY(g.safe) + 4, MAX(0, maxX - minX), MAX(0, CGRectGetHeight(g.safe) - 8));
+        return;
+    }
+    CGFloat minX = CGRectGetMinX(g.safe) + MAX(g.drop[DM_PAD_ZL].x + g.dropR[DM_PAD_ZL] - CGRectGetMinX(g.safe),
+                                              _full ? g.click[0].x + g.clickR - CGRectGetMinX(g.safe) : 0) + 6;
+    CGFloat maxX = MIN(CGRectGetMinX(g.pill[DM_PAD_MINUS]), g.swap.x - g.swapR) - 6;
+    DmPadShape shapes[20]; int n = dm_pad_shapes(&g, _full, shapes);
+    CGFloat rowBottom = CGRectGetMinY(g.safe) + 60 * g.u;
+    for (int i = 0; i < n; i++) {
+        if (shapes[i].id == DM_PAD_SHAPE_SWAP || (shapes[i].id >= DM_PAD_SHAPE_PILL && shapes[i].id < DM_PAD_SHAPE_PILL + 2)) continue;
+        if (shapes[i].id >= DM_PAD_SHAPE_DROP + DM_PAD_ZR && shapes[i].id <= DM_PAD_SHAPE_TIP + DM_PAD_R) continue;
+        if (shapes[i].id == DM_PAD_SHAPE_CLICK + 1) continue;
+        CGRect sb = dm_pad_shape_box(&shapes[i]);
+        if (CGRectGetMinY(sb) >= rowBottom) continue;
+        if (CGRectGetMidX(sb) < g.swap.x - 40 * g.u) minX = MAX(minX, CGRectGetMaxX(sb) + 6);
+        else maxX = MIN(maxX, CGRectGetMinX(sb) - 6);
+    }
+    CGFloat y = CGRectGetMinY(g.safe) + 2;
+    CGFloat midY = g.swap.y;
+    if (maxX - minX < 80) {
+        minX = CGRectGetMinX(g.safe) + 8;
+        maxX = MAX(minX + 80, g.swap.x - g.swapR - 8);
+        y = rowBottom + 4;
+        midY = -1;
+    }
+    if (compactOut) *compactOut = YES;
+    if (midYOut) *midYOut = midY;
+    if (slotOut) *slotOut = CGRectMake(minX, y, MAX(0, maxX - minX), MAX(0, CGRectGetMaxY(g.safe) - y));
 }
 @end
 
