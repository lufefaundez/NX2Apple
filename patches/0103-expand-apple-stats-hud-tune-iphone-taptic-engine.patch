+- (void)playTransientIntensity:(float)intensity sharpness:(float)sharpness {
+    if (!self.engine) return;
+    NSError *err = nil;
+    CHHapticEvent *ev = [[CHHapticEvent alloc] initWithEventType:CHHapticEventTypeHapticTransient parameters:@[
+        [[CHHapticEventParameter alloc] initWithParameterID:CHHapticEventParameterIDHapticIntensity value:intensity],
+        [[CHHapticEventParameter alloc] initWithParameterID:CHHapticEventParameterIDHapticSharpness value:sharpness]
+    ] relativeTime:0];
+    CHHapticPattern *pat = [[CHHapticPattern alloc] initWithEvents:@[ev] parameters:@[] error:&err];
+    id<CHHapticPatternPlayer> player = pat ? [self.engine createPlayerWithPattern:pat error:&err] : nil;
+    if (player) [player startAtTime:CHHapticTimeImmediate error:&err];
+}
+- (void)applyPhone:(const dm_vibration[2])motors {
+    dm_haptic_level level = {0, 0};
+    int fire = 0;
+    float t_int = 0, t_sharp = 0;
+    double last_t = self.lastTransientAt;
+    dm_haptics_apple_phone_synthesize(motors, gain, self.lastPhoneIntensity, now(), &last_t, &level, &fire, &t_int, &t_sharp);
+    if ([self applyLevel:level]) {
+        self.lastPhoneIntensity = level.intensity;
+        self.lastTransientAt = last_t;
+        if (fire) [self playTransientIntensity:t_int sharpness:t_sharp];
+    }
+}
 - (void)apply:(dm_haptic_level)level {
+    (void)[self applyLevel:level];
+}
