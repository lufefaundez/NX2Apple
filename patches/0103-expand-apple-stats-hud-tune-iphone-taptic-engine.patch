diff --git a/dm/host/haptics_apple.h b/dm/host/haptics_apple.h
index bd2ef35..85c17bd 100644
--- a/dm/host/haptics_apple.h
+++ b/dm/host/haptics_apple.h
@@ -7,6 +7,10 @@ void dm_haptics_apple_controller(int player, GCController *controller);
