diff --git a/dm/host/stats_apple.h b/dm/host/stats_apple.h
new file mode 100644
index 0000000..9da6e8c
--- /dev/null
+++ b/dm/host/stats_apple.h
@@ -0,0 +1,30 @@
+// System telemetry for the in-game stats HUD (CPU/GPU die temp, device/controller battery, thermal state).
+#pragma once
+#include <stddef.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+typedef struct {
+    double cpu_temp_c;       // NAN when unavailable (e.g., iOS/tvOS sandbox)
+    double gpu_temp_c;       // NAN when unavailable
+    int device_battery_pct;  // 0..100, -1 when unavailable (desktop Mac, tvOS, Simulator)
+    int device_charging;     // 1 charging, 0 not charging, -1 unknown
+    int pad_battery_pct;     // 0..100, -1 when no connected controller reports battery
+    int pad_charging;        // 1 charging, 0 not charging, -1 unknown
+    int thermal_state;       // NSProcessInfoThermalState: 0 nominal .. 3 critical, -1 unavailable
+} dm_stats_snapshot;
+
+void dm_stats_init(void);
+dm_stats_snapshot dm_stats_read(void);
+
+// Pure helpers (unit-tested in dm/host/tests/t_stats_apple.m)
+double dm_stats_temp_valid(double c);
+int dm_stats_smc_b62_prev(char c, char *prev);
+int dm_stats_smc_is_primary_reading(const char *const *keys, const double *vals, size_t count, size_t index);
+void dm_stats_format_hud(double fps, const dm_stats_snapshot *s, int compact, char *out, size_t cap);
+
+#ifdef __cplusplus
+}
+#endif
diff --git a/dm/host/stats_apple.m b/dm/host/stats_apple.m
new file mode 100644
index 0000000..eef2345
--- /dev/null
+++ b/dm/host/stats_apple.m
@@ -0,0 +1,366 @@
+// Honest Apple system telemetry: AppleSMC + IOPowerSources + IOHID (macOS), UIDevice + best-effort IOHID (iOS), GCController battery (all Apple platforms).
+#import "stats_apple.h"
+#import <Foundation/Foundation.h>
+#import <GameController/GameController.h>
+#include <TargetConditionals.h>
+#include <dlfcn.h>
+#include <math.h>
+#include <pthread.h>
+#include <stdio.h>
+#include <string.h>
+
+#if TARGET_OS_IPHONE
+#import <UIKit/UIKit.h>
+#else
+#import <IOKit/IOKitLib.h>
+#import <IOKit/ps/IOPSKeys.h>
+#import <IOKit/ps/IOPowerSources.h>
+#endif
+
+double dm_stats_temp_valid(double c) {
+    return isfinite(c) && c > 0.0 && c < 130.0 ? c : NAN;
+}
+
+int dm_stats_smc_b62_prev(char c, char *prev) {
+    if (!prev) return 0;
+    if (c >= '1' && c <= '9') { *prev = (char)(c - 1); return 1; }
+    if (c == 'A') { *prev = '9'; return 1; }
+    if (c >= 'B' && c <= 'Z') { *prev = (char)(c - 1); return 1; }
+    if (c == 'a') { *prev = 'Z'; return 1; }
+    if (c >= 'b' && c <= 'z') { *prev = (char)(c - 1); return 1; }
+    return 0;
+}
+
+// M4 SMC exposes per-core triads (e.g. Tp00/01/02) and GPU pairs (Tg0C/0D) where the first key is the die temp and
+// each consecutive base-62 key carries a higher fan/TDP/peak offset (+4.6 to +19 C), sometimes immediately abutting
+// the next cluster (Tp0U..0f, Te0R..0X). A key inside Tp/Te/Tg whose immediate base-62 predecessor exists and sits
+// more than 2.5 C cooler is treated as a derivative offset/peak rather than a physical sensor.
+int dm_stats_smc_is_primary_reading(const char *const *keys, const double *vals, size_t count, size_t index) {
+    if (!keys || !vals || index >= count) return 0;
+    const char *k = keys[index];
+    if (!k || strlen(k) != 4 || !isfinite(dm_stats_temp_valid(vals[index]))) return 0;
+    if (k[0] == 'T' && (k[1] == 'p' || k[1] == 'e' || k[1] == 'g')) {
+        char p3 = 0;
+        if (dm_stats_smc_b62_prev(k[3], &p3)) {
+            char prev_key[5] = {k[0], k[1], k[2], p3, 0};
+            for (size_t j = 0; j < count; j++) {
+                if (keys[j] && strcmp(keys[j], prev_key) == 0 && isfinite(vals[j])) {
+                    if (vals[index] > vals[j] + 2.5) return 0;
+                    break;
+                }
+            }
+        }
+    }
+    return 1;
+}
+
+static void append_seg(char *buf, size_t cap, const char *seg) {
+    if (!buf || !cap || !seg || !*seg) return;
+    size_t len = strlen(buf);
+    if (len == 0) snprintf(buf, cap, "%s", seg);
+    else snprintf(buf + len, cap > len ? cap - len : 0, " \xC2\xB7 %s", seg);
+}
+
+void dm_stats_format_hud(double fps, const dm_stats_snapshot *s, int compact, char *out, size_t cap) {
+    if (!out || cap == 0) return;
+    out[0] = '\0';
+    dm_stats_snapshot empty = {NAN, NAN, -1, -1, -1, -1, -1};
+    if (!s) s = &empty;
+
+    char fps_s[32], cpu_s[32], gpu_s[32];
+    if (isfinite(fps) && fps >= 0.0) snprintf(fps_s, sizeof fps_s, "%lld fps", (long long)llround(fps));
+    else snprintf(fps_s, sizeof fps_s, "-- fps");
+
+    double ct = dm_stats_temp_valid(s->cpu_temp_c);
+    if (isfinite(ct)) snprintf(cpu_s, sizeof cpu_s, "CPU %lld\xC2\xB0" "C", (long long)llround(ct));
+    else snprintf(cpu_s, sizeof cpu_s, "CPU --\xC2\xB0" "C");
+
+    double gt = dm_stats_temp_valid(s->gpu_temp_c);
+    if (isfinite(gt)) snprintf(gpu_s, sizeof gpu_s, "GPU %lld\xC2\xB0" "C", (long long)llround(gt));
+    else snprintf(gpu_s, sizeof gpu_s, "GPU --\xC2\xB0" "C");
+
+    char bat_s[32] = {0}, pad_s[32] = {0}, heat_s[32] = {0};
+    if (s->device_battery_pct >= 0) {
+        int pct = s->device_battery_pct > 100 ? 100 : s->device_battery_pct;
+        snprintf(bat_s, sizeof bat_s, "Bat %d%%%s", pct, s->device_charging == 1 ? "+" : "");
+    }
+    if (s->pad_battery_pct >= 0) {
+        int pct = s->pad_battery_pct > 100 ? 100 : s->pad_battery_pct;
+        snprintf(pad_s, sizeof pad_s, "Mando %d%%%s", pct, s->pad_charging == 1 ? "+" : "");
+    }
+    if (s->thermal_state >= 2) {
+        snprintf(heat_s, sizeof heat_s, "%s", s->thermal_state >= 3 ? "Cr\xC3\xADtico" : "Calor");
+    }
+
+    if (compact) {
+        char line1[128] = {0}, line2[128] = {0};
+        append_seg(line1, sizeof line1, fps_s);
+        append_seg(line1, sizeof line1, cpu_s);
+        append_seg(line1, sizeof line1, gpu_s);
+        append_seg(line2, sizeof line2, bat_s);
+        append_seg(line2, sizeof line2, pad_s);
+        append_seg(line2, sizeof line2, heat_s);
+        if (line2[0]) snprintf(out, cap, "%s\n%s", line1, line2);
+        else snprintf(out, cap, "%s", line1);
+    } else {
+        append_seg(out, cap, fps_s);
+        append_seg(out, cap, cpu_s);
+        append_seg(out, cap, gpu_s);
+        append_seg(out, cap, bat_s);
+        append_seg(out, cap, pad_s);
+        append_seg(out, cap, heat_s);
+    }
+}
+
+#if !TARGET_OS_IPHONE
+
+typedef struct { char major, minor, build, reserved; uint16_t release; } smc_vers_t;
+typedef struct { uint16_t version, length; uint32_t cpu_plimit, gpu_plimit, mem_plimit; } smc_plimit_t;
+typedef struct { uint32_t data_size, data_type; uint8_t data_attrs; } smc_keyinfo_t;
+typedef struct {
+    uint32_t key;
+    smc_vers_t vers;
+    smc_plimit_t plimit;
+    smc_keyinfo_t key_info;
+    uint8_t result, status, data8;
+    uint32_t data32;
+    uint8_t bytes[32];
+} smc_keydata_t;
+
+typedef struct {
+    char name[5];
+    uint32_t code, size, type;
+} smc_sensor_t;
+
+static uint32_t smc_u32(const char *s) {
+    return ((uint32_t)(uint8_t)s[0] << 24) | ((uint32_t)(uint8_t)s[1] << 16) | ((uint32_t)(uint8_t)s[2] << 8) | (uint32_t)(uint8_t)s[3];
+}
+
+static void smc_str(uint32_t v, char out[5]) {
+    out[0] = (char)((v >> 24) & 0xff); out[1] = (char)((v >> 16) & 0xff);
+    out[2] = (char)((v >> 8) & 0xff); out[3] = (char)(v & 0xff); out[4] = '\0';
+}
+
+static int smc_call(io_connect_t conn, const smc_keydata_t *in, smc_keydata_t *out) {
+    size_t sz = sizeof *out;
+    memset(out, 0, sizeof *out);
+    return IOConnectCallStructMethod(conn, 2, in, sizeof *in, out, &sz) == KERN_SUCCESS && out->result == 0;
+}
+
+static double smc_decode(uint32_t dtype, uint32_t sz, const uint8_t *b) {
+    if (dtype == smc_u32("flt ") && sz == 4) { float f = 0; memcpy(&f, b, 4); return dm_stats_temp_valid(f); }
+    if (dtype == smc_u32("sp78") && sz == 2) { int16_t s = (int16_t)((b[0] << 8) | b[1]); return dm_stats_temp_valid(s / 256.0); }
+    if (dtype == smc_u32("fpe2") && sz == 2) { uint16_t u = (uint16_t)((b[0] << 8) | b[1]); return dm_stats_temp_valid(u / 4.0); }
+    return NAN;
+}
+
+static pthread_mutex_t g_smc_lock = PTHREAD_MUTEX_INITIALIZER;
+static smc_sensor_t g_smc_sensors[256];
+static size_t g_smc_count;
+static int g_smc_scanned;
+
+static void smc_scan(io_connect_t conn) {
+    if (g_smc_scanned) return;
+    g_smc_scanned = 1;
+    smc_keydata_t in = {0}, out = {0};
+    in.key = smc_u32("#KEY"); in.data8 = 9;
+    if (!smc_call(conn, &in, &out) || out.key_info.data_size != 4) return;
+    memset(&in, 0, sizeof in); in.key = smc_u32("#KEY"); in.key_info.data_size = 4; in.data8 = 5;
+    if (!smc_call(conn, &in, &out)) return;
+    uint32_t total = ((uint32_t)out.bytes[0] << 24) | ((uint32_t)out.bytes[1] << 16) | ((uint32_t)out.bytes[2] << 8) | out.bytes[3];
+    if (total > 8192) total = 8192;
+    for (uint32_t i = 0; i < total && g_smc_count < sizeof g_smc_sensors / sizeof g_smc_sensors[0]; i++) {
+        memset(&in, 0, sizeof in); in.data8 = 8; in.data32 = i;
+        if (!smc_call(conn, &in, &out)) continue;
+        uint32_t code = out.key;
+        char k[5]; smc_str(code, k);
+        if (k[0] != 'T' || (k[1] != 'p' && k[1] != 'e' && k[1] != 'g' && k[1] != 'C' && k[1] != 'G')) continue;
+        memset(&in, 0, sizeof in); in.key = code; in.data8 = 9;
+        if (!smc_call(conn, &in, &out) || out.key_info.data_size == 0 || out.key_info.data_size > 32) continue;
+        uint32_t dtype = out.key_info.data_type, dsize = out.key_info.data_size;
+        if (!((dtype == smc_u32("flt ") && dsize == 4) || ((dtype == smc_u32("sp78") || dtype == smc_u32("fpe2")) && dsize == 2))) continue;
+        smc_sensor_t *s = &g_smc_sensors[g_smc_count++];
+        memcpy(s->name, k, 5);
+        s->code = code;
+        s->size = dsize;
+        s->type = dtype;
+    }
+}
+
+static void read_smc_temps(double *cpu_out, double *gpu_out) {
+    *cpu_out = NAN; *gpu_out = NAN;
+    pthread_mutex_lock(&g_smc_lock);
+    io_service_t svc = IOServiceGetMatchingService(kIOMainPortDefault, IOServiceMatching("AppleSMC"));
+    io_connect_t conn = 0;
+    if (!svc || IOServiceOpen(svc, mach_task_self(), 0, &conn) != KERN_SUCCESS) {
+        if (svc) IOObjectRelease(svc);
+        pthread_mutex_unlock(&g_smc_lock);
+        return;
+    }
+    smc_scan(conn);
+    const char *keys[256] = {0};
+    double vals[256] = {0};
+    size_t n = 0;
+    for (size_t i = 0; i < g_smc_count; i++) {
+        smc_keydata_t in = {0}, out = {0};
+        in.key = g_smc_sensors[i].code; in.key_info.data_size = g_smc_sensors[i].size; in.data8 = 5;
+        if (!smc_call(conn, &in, &out)) continue;
+        double v = smc_decode(g_smc_sensors[i].type, g_smc_sensors[i].size, out.bytes);
+        if (isfinite(v)) { keys[n] = g_smc_sensors[i].name; vals[n] = v; n++; }
+    }
+    IOServiceClose(conn);
+    IOObjectRelease(svc);
+    pthread_mutex_unlock(&g_smc_lock);
+
+    double p_sum = 0, g_sum = 0, intel_c_sum = 0, intel_g_sum = 0;
+    int p_cnt = 0, g_cnt = 0, intel_c_cnt = 0, intel_g_cnt = 0;
+    for (size_t i = 0; i < n; i++) {
+        if (!dm_stats_smc_is_primary_reading(keys, vals, n, i)) continue;
+        char c1 = keys[i][1];
+        if (c1 == 'p' || c1 == 'e') { p_sum += vals[i]; p_cnt++; }
+        else if (c1 == 'g') { g_sum += vals[i]; g_cnt++; }
+        else if (c1 == 'C') { intel_c_sum += vals[i]; intel_c_cnt++; }
+        else if (c1 == 'G') { intel_g_sum += vals[i]; intel_g_cnt++; }
+    }
+    if (p_cnt > 0) *cpu_out = p_sum / p_cnt;
+    else if (intel_c_cnt > 0) *cpu_out = intel_c_sum / intel_c_cnt;
+    if (g_cnt > 0) *gpu_out = g_sum / g_cnt;
+    else if (intel_g_cnt > 0) *gpu_out = intel_g_sum / intel_g_cnt;
+}
+
+static void read_mac_battery(int *pct_out, int *chg_out) {
+    *pct_out = -1; *chg_out = -1;
+    CFTypeRef info = IOPSCopyPowerSourcesInfo();
+    CFArrayRef list = info ? IOPSCopyPowerSourcesList(info) : NULL;
+    for (CFIndex i = 0; list && i < CFArrayGetCount(list); i++) {
+        NSDictionary *d = (__bridge NSDictionary *)IOPSGetPowerSourceDescription(info, CFArrayGetValueAtIndex(list, i));
+        if (![d[@(kIOPSTypeKey)] isEqualToString:@(kIOPSInternalBatteryType)]) continue;
+        NSNumber *cur = d[@(kIOPSCurrentCapacityKey)], *max = d[@(kIOPSMaxCapacityKey)];
+        if (cur && max && max.doubleValue > 0.0) {
+            int pct = (int)llround(fmax(0.0, fmin(100.0, cur.doubleValue * 100.0 / max.doubleValue)));
+            *pct_out = pct;
+            NSNumber *chg = d[@(kIOPSIsChargingKey)];
+            *chg_out = chg ? (chg.boolValue ? 1 : 0) : -1;
+            break;
+        }
+    }
+    if (list) CFRelease(list);
+    if (info) CFRelease(info);
+}
+
+#endif
+
+#if !TARGET_OS_TV
+static void read_iohid_temps(double *cpu_out, double *gpu_out) {
+    *cpu_out = NAN; *gpu_out = NAN;
+    void *h = dlopen("/System/Library/Frameworks/IOKit.framework/IOKit", RTLD_LAZY);
+    if (!h) return;
+    typedef void *(*create_fn)(CFAllocatorRef);
+    typedef void (*match_fn)(void *, CFDictionaryRef);
+    typedef CFArrayRef (*services_fn)(void *);
+    typedef CFTypeRef (*prop_fn)(void *, CFStringRef);
+    typedef void *(*event_fn)(void *, int64_t, int32_t, int64_t);
+    typedef double (*float_fn)(void *, uint32_t);
+    create_fn cr = (create_fn)dlsym(h, "IOHIDEventSystemClientCreate");
+    match_fn sm = (match_fn)dlsym(h, "IOHIDEventSystemClientSetMatching");
+    services_fn cs = (services_fn)dlsym(h, "IOHIDEventSystemClientCopyServices");
+    prop_fn cp = (prop_fn)dlsym(h, "IOHIDServiceClientCopyProperty");
+    event_fn ce = (event_fn)dlsym(h, "IOHIDServiceClientCopyEvent");
+    float_fn gf = (float_fn)dlsym(h, "IOHIDEventGetFloatValue");
+    if (!cr || !sm || !cs || !cp || !ce || !gf) return;
+    void *sys = cr(kCFAllocatorDefault);
+    if (!sys) return;
+    sm(sys, (__bridge CFDictionaryRef)@{@"PrimaryUsagePage": @0xff00, @"PrimaryUsage": @5});
+    CFArrayRef arr = cs(sys);
+    double cpu_sum = 0, gpu_sum = 0, pmu_sum = 0;
+    int cpu_cnt = 0, gpu_cnt = 0, pmu_cnt = 0;
+    for (CFIndex i = 0; arr && i < CFArrayGetCount(arr); i++) {
+        void *s = (void *)CFArrayGetValueAtIndex(arr, i);
+        NSString *prod = (__bridge_transfer NSString *)cp(s, CFSTR("Product"));
+        if (!prod.length) continue;
+        void *ev = ce(s, 15, 0, 0);
+        double v = ev ? dm_stats_temp_valid(gf(ev, 15u << 16)) : NAN;
+        if (ev) CFRelease(ev);
+        if (!isfinite(v)) continue;
+        if ([prod containsString:@"pACC"] || [prod containsString:@"eACC"] || [prod containsString:@"CPU"]) { cpu_sum += v; cpu_cnt++; }
+        else if ([prod containsString:@"GPU"]) { gpu_sum += v; gpu_cnt++; }
+        else if ([prod hasPrefix:@"PMU tdie"]) { pmu_sum += v; pmu_cnt++; }
+    }
+    if (arr) CFRelease(arr);
+    CFRelease(sys);
+    if (cpu_cnt > 0) *cpu_out = cpu_sum / cpu_cnt;
+    else if (pmu_cnt > 0) *cpu_out = pmu_sum / pmu_cnt;
+    if (gpu_cnt > 0) *gpu_out = gpu_sum / gpu_cnt;
+}
+#endif
+
+#if TARGET_OS_IOS && !TARGET_OS_TV
+static _Atomic int g_ios_bat_pct = -1;
+static _Atomic int g_ios_bat_chg = -1;
+
+static void update_ios_battery(void) {
+    UIDevice *dev = UIDevice.currentDevice;
+    if (!dev.batteryMonitoringEnabled) dev.batteryMonitoringEnabled = YES;
+    UIDeviceBatteryState st = dev.batteryState;
+    float lvl = dev.batteryLevel;
+    if (st == UIDeviceBatteryStateUnknown || !isfinite(lvl) || lvl < 0.0f) {
+        g_ios_bat_pct = -1; g_ios_bat_chg = -1;
+        return;
+    }
+    g_ios_bat_pct = (int)llroundf(fmaxf(0.0f, fminf(1.0f, lvl)) * 100.0f);
+    g_ios_bat_chg = (st == UIDeviceBatteryStateCharging) ? 1 : 0;
+}
+#endif
+
+static void read_pad_battery(int *pct_out, int *chg_out) {
+    *pct_out = -1; *chg_out = -1;
+    GCController *pick = nil;
+    for (GCController *c in GCController.controllers) {
+        GCDeviceBattery *b = c.battery;
+        if (!b || b.batteryState == GCDeviceBatteryStateUnknown || !isfinite(b.batteryLevel) || b.batteryLevel < 0.0f) continue;
+        if (c.playerIndex == GCControllerPlayerIndex1) { pick = c; break; }
+        if (!pick) pick = c;
+    }
+    if (!pick) return;
+    GCDeviceBattery *b = pick.battery;
+    *pct_out = (int)llroundf(fmaxf(0.0f, fminf(1.0f, b.batteryLevel)) * 100.0f);
+    *chg_out = (b.batteryState == GCDeviceBatteryStateCharging) ? 1 : 0;
+}
+
+void dm_stats_init(void) {
+    static dispatch_once_t once;
+    dispatch_once(&once, ^{
+#if TARGET_OS_IOS && !TARGET_OS_TV
+        void (^setup)(void) = ^{
+            UIDevice.currentDevice.batteryMonitoringEnabled = YES;
+            update_ios_battery();
+            NSNotificationCenter *nc = NSNotificationCenter.defaultCenter;
+            [nc addObserverForName:UIDeviceBatteryLevelDidChangeNotification object:nil queue:NSOperationQueue.mainQueue usingBlock:^(NSNotification *n) { (void)n; update_ios_battery(); }];
+            [nc addObserverForName:UIDeviceBatteryStateDidChangeNotification object:nil queue:NSOperationQueue.mainQueue usingBlock:^(NSNotification *n) { (void)n; update_ios_battery(); }];
+        };
+        if (NSThread.isMainThread) setup();
+        else dispatch_async(dispatch_get_main_queue(), setup);
+#endif
+    });
+}
+
+dm_stats_snapshot dm_stats_read(void) {
+    dm_stats_snapshot s = {NAN, NAN, -1, -1, -1, -1, (int)NSProcessInfo.processInfo.thermalState};
+#if !TARGET_OS_IPHONE
+    read_smc_temps(&s.cpu_temp_c, &s.gpu_temp_c);
+    if (!isfinite(s.cpu_temp_c) || !isfinite(s.gpu_temp_c)) {
+        double hc = NAN, hg = NAN;
+        read_iohid_temps(&hc, &hg);
+        if (!isfinite(s.cpu_temp_c)) s.cpu_temp_c = hc;
+        if (!isfinite(s.gpu_temp_c)) s.gpu_temp_c = hg;
+    }
+    read_mac_battery(&s.device_battery_pct, &s.device_charging);
+#elif !TARGET_OS_TV
+    read_iohid_temps(&s.cpu_temp_c, &s.gpu_temp_c);
+    if (NSThread.isMainThread) update_ios_battery();
+    s.device_battery_pct = g_ios_bat_pct;
+    s.device_charging = g_ios_bat_chg;
+#endif
+    read_pad_battery(&s.pad_battery_pct, &s.pad_charging);
+    return s;
+}
