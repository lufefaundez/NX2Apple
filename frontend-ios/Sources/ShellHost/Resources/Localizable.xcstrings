    "%@ is not in this game's folder. Install the game again.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ fehlt im Ordner dieses Spiels. Installiere das Spiel erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ is not in this game's folder. Install the game again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ no está en la carpeta de este juego. Instala el juego nuevamente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ n’est pas dans le dossier de ce jeu. Réinstallez le jeu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ non è nella cartella di questo gioco. Installa di nuovo il gioco."
