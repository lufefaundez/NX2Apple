  "sourceLanguage": "en",
  "strings": {
    "\"%@\" is not a DM_ switch.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@“ ist kein DM_-Schalter."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "\"%@\" is not a DM_ switch."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "\"%@\" no es un modificador DM_."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "« %@ » n’est pas un réglage DM_."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” non è un interruttore DM_."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\"%@\" は DM_ スイッチではありません。"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "”%@” är ingen DM_-växel."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\"%@\" 不是 DM_ 开关。"
          }
        }
      }
    },
